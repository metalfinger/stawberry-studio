# Stronger judge (seq 5/6 of thread judge-host): official block-FP8 build, vision tower bf16,
# split across both A5000s. Ampere has no FP8 cores; vLLM runs it W8A16 through Marlin.
MODEL_PATH=$HOME/models/qwen3.5-27b-fp8
JUDGE_MODEL=Qwen/Qwen3.5-27B-FP8
GPUS=0,1
TP=2
VLLM_GPU_UTIL=0.75
MAX_MODEL_LEN=8192
# vLLM's custom all-reduce needs CUDA IPC/P2P, which WSL does not give it; plain NCCL does the job.
EXTRA_ARGS=--disable-custom-all-reduce
